#compdef cp-cli

_cp_cli() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '1: :->cmds' \
        '*:: :->args'

    case $state in
        cmds)
            local -a commands
            commands=(
                'new:Create a new contest (requires URL)'
                'add:Add a single file with template'
                'mark:Mark problem status (default: AC)'
                'status:Show contest progress summary'
                'clean:Remove compiled binaries'
                'update:Update info.md'
            )
            _describe 'command' commands
            ;;
        args)
            case $line[1] in
                clean|update)
                    _arguments \
                        '--all[Apply to all]' \
                        '*:directory:_files -/'
                    ;;
                status)
                    _files -/
                    ;;
                *)
                    _files
                    ;;
            esac
            ;;
    esac
}

_cp_cli "$@"
